class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        HashMap<Integer,Integer> m = new HashMap<>();

        for (int n : nums)
            m.put(n, m.getOrDefault(n, 0) + 1);

        PriorityQueue<Integer> q =
            new PriorityQueue<>((a,b) -> m.get(a) - m.get(b));

        for (int n : m.keySet()) {
            q.add(n);
            if (q.size() > k) q.poll();
        }

        int[] ans = new int[k];
        for (int i = 0; i < k; i++)
            ans[i] = q.poll();

        return ans;
    }
}
